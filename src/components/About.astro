---
import { t, type Lang } from '../i18n';
import site from '../data/site.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
---

<section id="about" class="about section">
  <div class="about__copy">
    <h2 class="h2">{s.who.title}</h2>
    <p class="body-copy">{s.who.p1}</p>
    <p class="body-copy">{s.who.p2}</p>
    <p class="body-copy">
      {s.who.p3}
      <a id="apply" href={site.links.apply} class="about__inline-link">{s.who.p3link}</a>.
    </p>
    <div class="about__actions">
      <a href={site.links.apply} class="pill pill--primary">
        {s.buttons.apply}
        <span class="pill__arrow" aria-hidden="true">↙</span>
      </a>
      <a href="#charter" class="pill pill--secondary">{s.buttons.readCharter}</a>
    </div>
  </div>
  <div class="about__photo" role="img" aria-label={s.who.photo}>
    <span aria-hidden="true">{s.who.photo}</span>
  </div>
</section>

<style>
  .about {
    padding-top: 160px;
    padding-bottom: 120px;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 64px;
    align-items: start;
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .about__copy .body-copy {
    max-width: 720px;
  }

  .about__inline-link {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .about__photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    background: var(--surface-2);
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-hero-2);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      padding-top: 100px;
      padding-bottom: 80px;
      gap: 48px;
    }
  }
</style>
