---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
---

<section id="about" class="about section">
  <div class="about__copy">
    <h2 class="h2">{s.who.title}</h2>
    <p class="body-copy">{s.who.p1}</p>
    <p class="body-copy">{s.who.p2}</p>
    <div class="about__actions">
      <a href="#charter" class="pill pill--secondary">{s.buttons.readCharter}</a>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 160px;
    padding-bottom: 120px;
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .about__copy .body-copy {
    max-width: 720px;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }


  @media (max-width: 900px) {
    .about {
      padding-top: 100px;
      padding-bottom: 80px;
    }
  }
</style>
