---
import { t, type Lang } from '../i18n';
import employers from '../data/employers.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
---

<section class="employers section" aria-labelledby="employers-label">
  <span id="employers-label" class="employers__label">{s.employers.label}</span>
  <ul class="employers__grid">
    {
      employers.map((e) => (
        <li class="employers__tile">
          {e.logo ? <img src={e.logo} alt={e.name} loading="lazy" /> : <span>{e.name}</span>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .employers {
    padding-top: 80px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .employers__label {
    font-size: 15px;
    color: var(--text-subtle);
  }

  .employers__grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }

  .employers__tile {
    height: 112px;
    border-radius: var(--radius-tile);
    background: var(--surface);
    display: grid;
    place-items: center;
    font-size: 18px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: -0.01em;
    text-align: center;
    padding: 0 16px;
  }

  .employers__tile img {
    max-width: 70%;
    max-height: 48px;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .employers__grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
    }

    .employers__tile {
      height: 96px;
      font-size: 16px;
    }
  }
</style>
